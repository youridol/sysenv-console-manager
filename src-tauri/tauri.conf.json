{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "SysEnv Console Manager",
  "version": "2.1.0",
  "identifier": "com.secm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SysEnv Console Manager",
        "width": 1400,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-gpu --proxy-bypass-list=<local>;ipc.localhost;localhost;127.0.0.1;::1;[::1]"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: https://ipc.localhost http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/driver/PawnIO.sys": "resources/driver/PawnIO.sys",
      "resources/driver/PawnIO.cat": "resources/driver/PawnIO.cat",
      "resources/driver/pawnio.inf": "resources/driver/pawnio.inf",
      "resources/driver/PawnIO-src": "resources/driver/PawnIO-src",
      "resources/lhm/publish": "lhm/publish",
      "resources/lhm/LICENSE-MPL-2.0.txt": "lhm/LICENSE-MPL-2.0.txt",
      "resources/lhm/LICENSE-GPL-2.0-PawnIO.txt": "lhm/LICENSE-GPL-2.0-PawnIO.txt",
      "resources/lhm/PawnIo-COPYING-LGPL-2.1.txt": "lhm/PawnIo-COPYING-LGPL-2.1.txt",
      "resources/lhm/THIRD-PARTY-NOTICES-LHM.txt": "lhm/THIRD-PARTY-NOTICES-LHM.txt",
      "resources/lhm/source": "lhm/source",
      "resources/iperf3/iperf3.exe": "iperf3/iperf3.exe",
      "resources/iperf3/cygwin1.dll": "iperf3/cygwin1.dll",
      "resources/iperf3/LICENSE-IPERF3-BSD-3-Clause.txt": "iperf3/LICENSE-IPERF3-BSD-3-Clause.txt",
      "resources/iperf3/LICENSE-LGPL-3.0.txt": "iperf3/LICENSE-LGPL-3.0.txt",
      "resources/iperf3/LICENSE-GPL-3.0.txt": "iperf3/LICENSE-GPL-3.0.txt",
      "resources/iperf3/THIRD-PARTY-NOTICES-IPERF3.txt": "iperf3/THIRD-PARTY-NOTICES-IPERF3.txt"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "wix": {}
    }
  }
}
