{
  "name": "sysenv-console-manager",
  "private": true,
  "version": "1.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "stage:driver": "node scripts/stage-driver.mjs",
    "tauri:build": "npm run stage:driver && npm run stage:lhm && npm run audit:drivers && tauri build",
    "lhm:publish": "cd sidecar-lhm && dotnet publish -c Release -r win-x64 --self-contained true -o bin/Release/net8.0/win-x64/publish",
    "stage:lhm": "node scripts/stage-lhm.mjs",
    "audit:drivers": "node scripts/audit-driver-signatures.mjs",
    "package:portable": "node scripts/package-portable.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-store": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0"
  },
  "lint-staged": {
    "src-tauri/src/**/*.rs": [
      "rustfmt --edition 2021"
    ],
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
